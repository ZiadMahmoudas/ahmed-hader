{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/w/ahmed-hadder",
      "destination": "/w/ahmed-hadeer",
      "permanent": true
    },
    {
      "source": "/w/ahmed-hader",
      "destination": "/w/ahmed-hadeer",
      "permanent": true
    },
    {
      "source": "/w/ahmed",
      "destination": "/w/ahmed-hadeer",
      "permanent": true
    },
    {
      "source": "/w/ahemd",
      "destination": "/w/ahmed-hadeer",
      "permanent": true
    }
  ]
}
