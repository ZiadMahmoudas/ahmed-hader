{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{"key":"Cache-Control","value":"public, max-age=3600, stale-while-revalidate=86400"}]
    }
  ],
  "rewrites": [
    {"source":"/w/ahmed-hadder","destination":"/index.html"},
    {"source":"/w/:guest","destination":"/index.html"}
  ]
}
